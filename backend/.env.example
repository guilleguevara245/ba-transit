DB_NAME=batransit
DB_USER=batransit
DB_PASSWORD=changeme

# Credenciales de la API Transporte de Buenos Aires (apitransporte.buenosaires.gob.ar)
# NUNCA subir el .env real con las credenciales verdaderas a GitHub.
TRANSPORTE_CLIENT_ID=
TRANSPORTE_CLIENT_SECRET=

# Origenes permitidos por CORS, separados por coma. En local no hace falta
# tocarlo (usa http://localhost:5173 por defecto). En produccion, el
# dominio real del frontend desplegado (ej: https://ba-transit.vercel.app)
FRONTEND_ORIGINS=
