DB_NAME=batransit
DB_USER=batransit
DB_PASSWORD=changeme
# En produccion (Neon): require, para que la conexion vaya siempre cifrada.
DB_SSLMODE=prefer

# Credenciales de la API Transporte de Buenos Aires (apitransporte.buenosaires.gob.ar)
# NUNCA subir el .env real con las credenciales verdaderas a GitHub.
TRANSPORTE_CLIENT_ID=
TRANSPORTE_CLIENT_SECRET=

# Origenes permitidos por CORS, separados por coma. En local no hace falta
# tocarlo (usa http://localhost:5173 por defecto). En produccion, el
# dominio real del frontend desplegado (ej: https://ba-transit.vercel.app)
FRONTEND_ORIGINS=

# Clave para los endpoints de escritura (POST /api/v1/alerts, /fares).
# Se manda en el header X-API-Key. Si queda vacia, la escritura queda
# deshabilitada. Generar una larga y aleatoria, por ejemplo:
#   openssl rand -hex 32
ADMIN_API_KEY=

# Feed GTFS de colectivos (opcional). Vacio = API Transporte con las
# credenciales de arriba. Para usar otra fuente, poner la URL del zip.
COLECTIVOS_GTFS_URL=

# Clave de la API de trafico de TomTom (developer.tomtom.com, plan
# gratuito). Sin ella, /accesos muestra los accesos sin estado en vivo.
TOMTOM_API_KEY=

# Mails con Brevo (brevo.com, plan gratuito): recuperar la contrasena y el
# formulario de contacto. MAIL_FROM: un remitente verificado en Brevo.
BREVO_API_KEY=
MAIL_FROM=
# A donde llegan los mensajes del formulario de contacto. Vacio = sin formulario.
CONTACT_EMAIL=
